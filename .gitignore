# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# travel provider gateway generated artifacts
/services/travel-provider-gateway/dist/
/services/travel-provider-gateway/coverage/
/services/travel-provider-gateway/probe-output/
/services/travel-provider-gateway/.cache/

# local brainstorming previews
/.superpowers/

# local Supabase CLI state
/supabase/.temp/
